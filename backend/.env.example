# Em Docker, MONGO_URL e DB_NAME vêm do docker-compose.yml. Fora do Docker, defina-os aqui:
# MONGO_URL="mongodb://localhost:27017"
# DB_NAME="maf_database"
JWT_SECRET="<gere com: openssl rand -hex 32>"
ADMIN_EMAIL="admin@seudominio.com"
ADMIN_PASSWORD="<senha forte, mínimo 12 caracteres>"
EMERGENT_EMAIL_KEY=""
EMAIL_FROM_NAME="MAF — Mundos Artificiais em Finanças"
NOTIFY_EMAIL=""
# true somente com HTTPS
COOKIE_SECURE="true"
# Swagger em /api/docs (deixe false em produção)
ENABLE_DOCS="false"
