# Template do nginx:alpine: ${TRUSTED_PROXY} é substituído na inicialização e o
# resultado vai para /etc/nginx/conf.d/default.conf (dentro do bloco http).

server_tokens off;

# IP real do visitante: só aceita X-Forwarded-For vindo do proxy confiável
# (em produção, o proxy da RNP que termina o TLS de maf.testbeds.rnp.br)
set_real_ip_from ${TRUSTED_PROXY};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

log_format maf '$remote_addr xff="$http_x_forwarded_for" "$request" $status $body_bytes_sent '
               '"$http_referer" "$http_user_agent" $request_time';
access_log /var/log/nginx/access.log maf;

# Limites contra força bruta e spam (por IP)
limit_req_zone $binary_remote_addr zone=auth:10m    rate=10r/m;
limit_req_zone $binary_remote_addr zone=contact:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api:10m     rate=20r/s;
limit_req_status 429;

# Protocolo original do visitante (o proxy da RNP informa; sem proxy, o da conexão)
map $http_x_forwarded_proto $original_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# O site é servido na 80 e na 443: o proxy da RNP pode encaminhar para qualquer uma
server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name _;

    # Certificado autoassinado gerado na inicialização; o certificado público
    # é o do proxy da RNP, que termina o TLS de maf.testbeds.rnp.br
    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # Nada de arquivos ocultos (.env, .git...)
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    location ~ ^/api/auth/(login|google)$ {
        limit_req zone=auth burst=5 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location = /api/contact {
        limit_req zone=contact burst=3 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # index.html nunca em cache, para o deploy aparecer na hora
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Arquivos do build têm hash no nome
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ~* \.(png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
