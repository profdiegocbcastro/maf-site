# Variáveis do docker compose (copie para .env na raiz)
IMAGE_PREFIX=ghcr.io/profdiegocbcastro/maf-site
IMAGE_TAG=latest
PORT=80
HTTPS_PORT=443
# domínio público (destino do redirecionamento HTTP -> HTTPS)
PUBLIC_HOST=seudominio.com
SERVER_URL=https://seudominio.com
# rede do proxy reverso na frente da VM (RNP: 200.133.57.0/24)
TRUSTED_PROXY=127.0.0.1/32
DB_NAME=maf_database
MONGO_USER=maf
# gere com: openssl rand -hex 24
MONGO_PASSWORD=
